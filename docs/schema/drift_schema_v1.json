        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"outbox\" (\"message_id\" TEXT NOT NULL REFERENCES messages (id) ON DELETE CASCADE, \"envelope\" BLOB NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, \"next_attempt\" INTEGER NOT NULL, PRIMARY KEY (\"message_id\"));"
        }
      ]
    },
