        }
      ]
    },
    {
      "name": "messages",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"messages\" (\"id\" TEXT NOT NULL, \"conversation_id\" TEXT NOT NULL REFERENCES conversations (id), \"body\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"expires_at\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"sequence\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
